PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/queueskip
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000

# Counters that mimic real-world office throughput.
# Every AVG_SERVICE_MINUTES, the "now serving" token advances by one.
AVG_SERVICE_MINUTES=4
COUNTERS_OPEN=3
