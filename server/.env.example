PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/queueskip
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Website address(es) allowed to call this API. Separate several with commas.
CLIENT_ORIGIN=http://localhost:3000

# Used only for the "estimated wait" shown to users.
AVG_SERVICE_MINUTES=4

# Admin login for the /admin panel. The account is created (or updated)
# every time the server starts.
ADMIN_EMAIL=admin@queueskip.test
ADMIN_PASSWORD=change-this-password
